<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCare.Views.CalculatorPage"
             Title="Maintenance Calculator" BackgroundColor="#F5F7FA">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Current Odometer Reading (km)" FontSize="12" TextColor="Gray"/>
            <Entry Text="{Binding Odometer}" Keyboard="Numeric" TextColor="#1F2A44"
                   Unfocused="OnOdometerUnfocused"/>

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" BackgroundColor="White" Stroke="#E3E8EF" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#1F2A44"/>
                                    <Label Grid.Column="1" Text="{Binding Status}"
                                           TextColor="{Binding StatusColor}" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="{Binding KmText}" FontSize="20" FontAttributes="Bold" TextColor="#1F2A44"/>
                                <Label Text="{Binding DaysText}" FontSize="12" TextColor="Gray"/>
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding StatusColor}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding NoRecordText}" FontSize="12" TextColor="Gray"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
